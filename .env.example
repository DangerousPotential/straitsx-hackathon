# Create .env.local and use a newly generated key. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Bright Data remote MCP token. Enables live Amazon SG listing acquisition.
BRIGHTDATA_API_TOKEN=

# Per-user issuance ceiling. The StraitsX sandbox provider also caps cards at S$30.
USER_TRANSACTION_LIMIT_SGD=30
